# Copy to .env (never commit .env). Used by docker compose and local runs.
# ONE key for both services: chat (agent-service) and embeddings (knowledge-service).
OPENROUTER_API_KEY=sk-or-v1-REPLACE_ME
LLM_MODEL=openai/gpt-4o-mini
EMBEDDING_MODEL=openai/text-embedding-3-small
# LLM_FALLBACK_MODELS=meta-llama/llama-3.3-70b-instruct
# Tracing with `docker compose --profile tracing up`:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
