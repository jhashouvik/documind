# knowledge-service configuration (KEY=value). Change a value, commit, push:
# the ConfigMap name hash changes -> new Rollout revision -> blue-green release.
# APP_VERSION is not set here: the image sets it (docker build --build-arg APP_VERSION=...)
LOG_LEVEL=INFO
QDRANT_URL=http://qdrant:6333
# one collection per embedding model: documind__<model-slug>
COLLECTION_PREFIX=documind
# Embeddings come from OpenRouter (POST https://openrouter.ai/api/v1/embeddings)
EMBEDDING_PROVIDER=openrouter
# default in the UI
EMBEDDING_MODEL=openai/text-embedding-3-small
EMBEDDING_MODELS=openai/text-embedding-3-small,openai/text-embedding-3-large,qwen/qwen3-embedding-0.6b
EMBED_BATCH_SIZE=64
EMBED_TIMEOUT_S=30
EMBED_MAX_RETRIES=3
# Chunking defaults + the limits the UI sliders may use
CHUNK_SIZE=800
CHUNK_OVERLAP=120
MIN_CHUNK_SIZE=200
MAX_CHUNK_SIZE=4000
MAX_UPLOAD_MB=20
DEFAULT_TOP_K=5
MAX_TOP_K=20
SCORE_THRESHOLD=0.25
APP_URL=http://documind.localtest.me
# Tracing (Day 10). Empty = tracing off. Set to the OTel Collector to turn it on:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.observability:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
