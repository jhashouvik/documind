# agent-service 2.0 configuration (KEY=value). Change a value, commit, push:
# the ConfigMap name hash changes -> new Rollout revision -> canary release.
# APP_VERSION is not set here: the image sets it (docker build --build-arg APP_VERSION=...)
# the Rollout adds the pod label track=stable|canary itself (ephemeral metadata)
# DATABASE_URL is built in rollout.yaml from the documind-postgres Secret.
TRACK=rollout
LOG_LEVEL=INFO
# Any OpenRouter model that supports tool calling (filter by "tools" on openrouter.ai/models)
# default in the UI
LLM_MODEL=openai/gpt-4o-mini
# allow-list the UI Settings panel may pick from (per-request override)
LLM_MODELS=openai/gpt-4o-mini,openai/gpt-4.1-mini,meta-llama/llama-3.3-70b-instruct
# e.g. "meta-llama/llama-3.3-70b-instruct"
LLM_FALLBACK_MODELS=
# cheaper model for grader/rewriter/memory; empty = same model
LLM_SMALL_MODEL=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=900
LLM_AUX_MAX_TOKENS=600
LLM_JUDGE_MAX_TOKENS=2000
LLM_TIMEOUT_S=60
PROMPT_VERSION=v1
AGENT_MAX_STEPS=5
# upper bounds for the UI sliders
MAX_STEPS_LIMIT=8
MAX_TOKENS_LIMIT=2000
MAX_QUERY_REWRITES=1
PLANNER_MAX_SUBQUESTIONS=4
MAX_REVISIONS=1
GROUNDING_CHECK=true
LONG_TERM_MEMORY=true
GRAPH_RECURSION_LIMIT=80
HISTORY_MAX_MESSAGES=12
KNOWLEDGE_URL=http://knowledge-service:8001
KNOWLEDGE_TIMEOUT_S=15
SEARCH_TOP_K=4
MAX_SEARCH_TOP_K=10
# rate limiting only (conversation memory is in Postgres)
REDIS_URL=redis://redis:6379/0
RATE_LIMIT_PER_MINUTE=20
# connections per pod: replicas (KEDA max 6) x 5 = 30 < Postgres max_connections 100
DB_POOL_SIZE=5
DB_CONNECT_RETRIES=30
APP_URL=http://documind.localtest.me
# Tracing (Day 10): empty = off. TRACE_CONTENT=true also records prompts/answers (privacy!)
OTEL_EXPORTER_OTLP_ENDPOINT=
TRACE_CONTENT=false
